// ### Instalar o Prisma: Yarn add prisma
// ### publicar as alterações do Prisma: yarn prisma migrate dev

// ### PRISMA STUDIO: yarn prisma studio
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  //indicando relacionamento
  questions Question[]

  //define como a coluna irá se chamar 
  @@map("users")
}

model Question {
  id        String    @id @default(uuid())
  title     String
  slug      String    @unique
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updateAt  DateTime? @updatedAt @map("updated_at")
  authorId  String    @map("author_id")

  //criando um relacionamento
  author    User      @relation(fields: [authorId], references: [id])

  @@map("questions")
}
